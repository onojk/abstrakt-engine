<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!--
        Monochrome adaptive-icon layer (Material You themed icons, Android 13+).
        Single white fill on transparent — the launcher tints this one colour.

        Shape: flat-top hexagram (6-pointed star) whose six outer tips land on the
        exact same vertices as the full-colour foreground hexagon (r=32 from centre).
        Inner notch radius = 18 gives a sharp star that reads clearly at small size.
        Even-odd fill punches out the centre ring (r=7) for visual depth.
        All geometry sits within the 66dp adaptive-icon safe zone (r ≤ 33).
    -->
    <path
        android:fillColor="#FFFFFF"
        android:fillType="evenOdd"
        android:pathData="
            M 86,54
            L 69.6,45   L 70,26.3
            L 54,36
            L 38,26.3   L 38.4,45
            L 22,54
            L 38.4,63   L 38,81.7
            L 54,72
            L 70,81.7   L 69.6,63
            Z
            M 47,54
            a 7,7 0 1,0 14,0
            a 7,7 0 1,0 -14,0" />
</vector>
